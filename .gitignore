# Dependencies
node_modules/

# Framework checkout created by `npm run update-framework`
.framework/

# Sibling framework repo symlink (created by remote dev environments)
/slashed

# Plugin package output (root dist/) — produced by `npm run build:zip`.
# NOTE: SLASHED-for-WP/dist/*.css is the shipped local-first CSS and IS tracked.
/dist/
.tmp-plugin-stage/

# Built SPA source maps — regenerate locally via `npm run build:apps`.
SLASHED-for-WP/integrations/bricks/editor-app/*.map
SLASHED-for-WP/integrations/bricks/assets/editor-app/*.map
SLASHED-for-WP/assets/admin-app/*.map

# OS / editor cruft
.DS_Store
.agents/
.claude/

# Playwright test fixtures and screenshot output
test-admin*.html
test-screenshots/


# PHP Composer dependencies (PHPCS/WPCS + PHPStan tooling).
# composer.json + composer.lock are tracked; the installed tree is not.
/vendor/
