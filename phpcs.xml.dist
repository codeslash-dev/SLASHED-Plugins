<?xml version="1.0"?>
<ruleset name="SLASHED for WP">
  <description>Coding standards for the SLASHED for WordPress plugin.</description>

  <!-- What to scan. -->
  <file>SLASHED-for-WP</file>

  <!-- Generated / vendored / build output: never our code to lint. -->
  <exclude-pattern>*/dist/*</exclude-pattern>
  <exclude-pattern>*/data/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <!-- Only PHP. -->
  <arg name="extensions" value="php"/>
  <!-- Show sniff codes, use colour, run in parallel, progress dots. -->
  <arg name="colors"/>
  <arg value="sp"/>
  <arg name="parallel" value="8"/>
  <arg name="basepath" value="."/>

  <!--
    Start with high-signal correctness & security sniffs rather than the full
    WordPress formatting ruleset. This catches real bugs (unsanitised input,
    unprepared SQL, unescaped output, deprecated/unsafe functions) without
    blocking on whitespace/alignment style that the existing code predates.
    Broaden toward WordPress-Extra over time once the codebase is reformatted.
  -->
  <rule ref="WordPress.Security"/>
  <rule ref="WordPress.DB"/>
  <rule ref="WordPress.WP.DeprecatedFunctions"/>
  <rule ref="WordPress.WP.DeprecatedParameters"/>
  <rule ref="WordPress.WP.EnqueuedResources"/>
  <rule ref="WordPress.PHP.NoSilencedErrors"/>
  <rule ref="WordPress.PHP.StrictInArray"/>

  <!-- PHP cross-version compatibility for the plugin's declared floor. -->
  <rule ref="PHPCompatibilityWP"/>
  <config name="testVersion" value="7.4-"/>

  <!-- Tell the i18n/security sniffs about the plugin's conventions. -->
  <config name="text_domain" value="slashed"/>

  <!-- Advisory warnings (e.g. object-cache suggestions) inform but don't fail
       the build; only errors block a merge. -->
  <config name="ignore_warnings_on_exit" value="1"/>
</ruleset>
